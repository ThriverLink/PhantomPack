<!-- Floating price tag for the pack and the wallet tab. -->
<style>
  .tag {
    flex-direction: column;
    width: 160;
    padding-top: 10;
    padding-bottom: 10;
    padding-left: 14;
    padding-right: 14;
    gap: 3;
    background-color: #0D171C;
    border-color: #FFB25C;
    border-width: 1;
    border-radius: 12;
  }

  .eyebrow {
    color: #8FA5AD;
    font-size: 9;
    font-weight: 700;
    letter-spacing: 1.3;
  }

  .price {
    color: #FFB25C;
    font-size: 30;
    font-weight: 700;
  }

  .body {
    color: #C5D3D8;
    font-size: 12;
    font-weight: 600;
  }
</style>
<div class="tag">
  <div class="eyebrow" id="tagEyebrow">PHANTOM · 20</div>
  <div class="price" id="tagTitle">$8.00</div>
  <div class="body" id="tagBody">1 day · 20 cigarettes</div>
</div>
